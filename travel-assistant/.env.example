# ============================================================
# 漫游 · 智能旅行助手  本地环境变量
# ------------------------------------------------------------
# 1. 在下面四个空白字段里填入你的 Key
# 2. 修改 VITE_* 后需要重新构建前端：cd frontend && pnpm build
# 3. 修改 AMAP_KEY / LLM_* 后需要重启后端
# ============================================================

# ---------- 高德地图 · 服务端 Web 服务 Key（必填） ----------
# 高德控制台 -> 应用管理 -> 我的应用 -> 添加 Key -> Web服务
# 用于：POI 检索、路线规划、静态地图、任意城市规划
AMAP_KEY=

# 可选：如果你的 Key 在控制台里叫 AMAP_WEB_KEY，也可以填这里（与上一项二选一）
AMAP_WEB_KEY=

# ---------- 高德地图 · 浏览器 JS API（必填，真实地图） ----------
# 高德控制台 -> 添加 Key -> Web端(JS API)
VITE_AMAP_KEY=

# 与 VITE_AMAP_KEY 配套的安全密钥（必填，否则地图会降级为示意图）
VITE_AMAP_SECURITY_CODE=

# ---------- 大模型 · OpenAI 兼容接口（必填，启用 AI 编排） ----------
# DeepSeek 示例：https://api.deepseek.com/v1
# 通义千问示例：https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- 可选配置（一般留空即可） ----------
# 自定义 Chrome/Chromium 路径，用于导出 PDF/PNG；留空会自动探测
CHROME_BIN=

# 默认使用 SQLite；需要 PostgreSQL 时取消注释并填写
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/travel
